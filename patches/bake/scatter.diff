+/* Grouped training samples (-DNRC_GROUP_N=N, dump cubins only): the samples s of a pixel with the same s / N form a
+ * group. The group is tagged as a whole (hash of pixel and s / N), and its N paths share the camera sample of the
+ * group's first sample (filter, lens and time dimensions; init_from_camera), so they reach the same first vertex x1;
+ * all later dimensions keep their own sample index, so the N paths take independent BSDF samples at x1 (stratified with
+ * Sobol). nrc_stash writes the group key into the record's padding features 14-15 (unused by the engine and the
+ * offline trainer: N_USED = 14), and the host averages the targets of records with the same key and features. */
+#  ifdef NRC_GROUP_N
+ccl_device_forceinline bool nrc_group_tagged(const uint pixel, const uint sample)
+{
+  return kernel_nrc.enabled && kernel_nrc.ctrl->train &&
+         hash_uint2(pixel, sample / uint(NRC_GROUP_N)) < kernel_nrc.train_threshold;
+}
+ccl_device_forceinline uint nrc_group_key(const uint pixel, const uint sample)
+{
+  return 0x80000000u | ((pixel & 0x7fffffu) << 8) | ((sample / uint(NRC_GROUP_N)) & 0xffu);
+}
+#  endif
