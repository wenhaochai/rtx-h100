+/* Variance gate table: per cell (position 32^3 x normal 4 x 4), sum w, sum w y, sum w y^2, count; y = target
+ * luminance, w = record throughput. Static device memory, zero at module load (one render per process). */
+#  define NRC2_GATE_LOG2 20
+#  ifdef __KERNEL_GPU__
+__device__ float nrc2_gate_tab[(1 << NRC2_GATE_LOG2) * 4];
+#  endif
