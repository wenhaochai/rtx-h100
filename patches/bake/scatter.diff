+/* Scattered form, before the bounce (Mueller et al. 2021): the cache answers the radiance the vertex scatters
+ * towards the previous vertex through its BSDF (emission and NEE at the vertex stay exact), weighted by the
+ * throughput before the bounce. The decision may not depend on the sampled lobe, so a vertex qualifies by its
+ * closures: no BSSRDF, transparent or portal closure, and at most 10% of the BSDF weight in lobes with roughness
+ * below rmin. */
+ccl_device_inline bool nrc_cacheable(const ccl_private ShaderData *sd)
+{
+  const float rmin = nrc2_rmin();
+  float sharp = 0.0f, total = 0.0f;
+  for (int i = 0; i < sd->num_closure; i++) {
+    const ccl_private ShaderClosure *sc = &sd->closure[i];
+    if (CLOSURE_IS_BSSRDF(sc->type) || CLOSURE_IS_BSDF_SINGULAR(sc->type)) {
+      return false;
+    }
+    if (!CLOSURE_IS_BSDF(sc->type)) {
+      continue;
+    }
+    const float w = fabsf(average(sc->weight));
+    total += w;
+    if (!CLOSURE_IS_BSDF_DIFFUSE(sc->type)) {
+      const float r2 = bsdf_get_roughness_pass_squared(sc);
+      if (r2 >= 0.0f && sqrtf(sqrtf(r2)) < rmin) {
+        sharp += w;
+      }
+    }
+  }
+  return total > 0.0f && sharp <= 0.1f * total;
+}
