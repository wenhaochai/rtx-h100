+ccl_device_inline uint nrc2_gate_cell(const float px, const float py, const float pz, const float nt, const float np)
+{
+  const int ix = clamp(int(px * 32.0f), 0, 31), iy = clamp(int(py * 32.0f), 0, 31),
+            iz = clamp(int(pz * 32.0f), 0, 31);
+  const int n = clamp(int(nt * 4.0f), 0, 3) * 4 + clamp(int(np * 4.0f), 0, 3);
+  return hash_uint3(uint(ix) | (uint(n) << 8), uint(iy), uint(iz)) & ((1u << NRC2_GATE_LOG2) - 1u);
+}
+
+ccl_device_inline bool nrc2_gate_ok(const uint cell)
+{
+  const ccl_global float *t = nrc2_gate_tab + 4 * (size_t)cell;
+  const float w = t[0], m1 = t[1], m2 = t[2], n = t[3];
+  return n >= 32.0f && m1 > 0.0f && m2 * w <= (1.0f + nrc2_tau()) * m1 * m1;
+}
+
+/* Demodulation factor of a feature row, channel c: diffuse + specular albedo, at least 0.02. */
+ccl_device_forceinline float nrc2_albedo(const ccl_global unsigned short *f, const int c)
+{
+  return fmaxf(half_to_float(f[8 + c]) + half_to_float(f[11 + c]), 0.02f);
+}
