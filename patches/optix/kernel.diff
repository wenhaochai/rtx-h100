diff --git a/intern/cycles/kernel/integrator/subsurface_random_walk.h b/intern/cycles/kernel/integrator/subsurface_random_walk.h
index fba906a..8c743f9 100644
--- a/intern/cycles/kernel/integrator/subsurface_random_walk.h
+++ b/intern/cycles/kernel/integrator/subsurface_random_walk.h
@@ -476,6 +476,31 @@ ccl_device_inline bool subsurface_random_walk(KernelGlobals kg,
       /* Avoid unnecessary work and precision issue when throughput gets really small. */
       break;
     }
+#  if defined(CYCLES_SSS_WALK_RR_Q) && defined(__KERNEL_OPTIX__)
+    /* Ours (OptiX route): the walk roulette of the CUDA dynamic-fetch walk (subsurface_walk_steps.h,
+     * sss_walk_step_end) in the stock walk, which the OptiX module runs: after K0 steps (K0I for walks
+     * that start at an indirect vertex) continue with probability Q/1000 (QI/1000) and divide the
+     * throughput by it; a walk that stops ends without an exit, as at the step cap. Unbiased. */
+    {
+#    if defined(CYCLES_SSS_WALK_RR_QI)
+      const bool sss_indirect = INTEGRATOR_STATE(state, path, bounce) > 0;
+      const int sss_k0 = sss_indirect ? CYCLES_SSS_WALK_RR_K0I : CYCLES_SSS_WALK_RR_K0;
+      const float q = float(sss_indirect ? CYCLES_SSS_WALK_RR_QI : CYCLES_SSS_WALK_RR_Q) * 0.001f;
+#    else
+      const int sss_k0 = CYCLES_SSS_WALK_RR_K0;
+      const float q = float(CYCLES_SSS_WALK_RR_Q) * 0.001f;
+#    endif
+      if (bounce + 1 >= sss_k0) {
+        const float u = hash_uint4_to_float(
+            rng_state.rng_pixel, uint(rng_state.sample), rng_state.rng_offset, uint(bounce) ^ 0x5bd1e995u);
+        if (u >= q) {
+          hit = false;
+          break;
+        }
+        throughput /= q;
+      }
+    }
+#  endif
   }
 
   if (hit) {
