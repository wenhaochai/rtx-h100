 #define ccl_device_inline __device__ __inline__
 #define ccl_device_forceinline __device__ __forceinline__
 #define ccl_device_noinline __device__ __noinline__
+/* Ours: CYCLES_INLINE_HOT=1 force-inlines the hot BSDF, shader-setup, local-BVH and light-tree functions that
+ * nvcc inlines once SVM node pruning shrinks the interpreter; =2 also the surface_shader BSDF evaluators.
+ * Unset: the same qualifier as before (__inline__), so the cubin does not change. */
+#if defined(CYCLES_INLINE_HOT) && CYCLES_INLINE_HOT >= 1
+#  define ccl_device_hot __device__ __forceinline__
+#else
+#  define ccl_device_hot __device__ __inline__
+#endif
+#if defined(CYCLES_INLINE_HOT) && CYCLES_INLINE_HOT >= 2
+#  define ccl_device_hot2 __device__ __forceinline__
+#else
+#  define ccl_device_hot2 __device__ __inline__
+#endif
 #define ccl_device_noinline_cpu ccl_device
 #define ccl_device_inline_method ccl_device
 #define ccl_device_template_spec template<> ccl_device_inline
