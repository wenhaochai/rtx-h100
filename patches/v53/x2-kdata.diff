+#ifdef CYCLES_KDATA_CONST
+/* Ours: per-scene compile-time KernelData. The generated header CYCLES_KDATA_CONST_HEADER defines one struct
+ * KDC_<Struct> per data_template.h struct, derived from it with no extra storage; its static constexpr members
+ * shadow the folded fields, so kernel_data.<parent>.<name> is a constant for them and a __constant__ load for the
+ * rest. KernelDataKC has KernelData's layout, so the host uploads the same bytes. */
+#  include CYCLES_KDATA_CONST_HEADER
+struct ccl_align(16) KernelDataKC {
+  uint64_t kernel_features;
+  uint max_closures;
+  uint max_shaders;
+  uint volume_stack_size;
+  KernelCamera cam;
+  KernelBake bake;
+  KernelTables tables;
+  KernelLightLinkSet light_link_sets[LIGHT_LINK_SET_MAX];
+  KernelSceneTime scene_time;
+#  define KERNEL_STRUCT_BEGIN(name, parent) KDC_##name parent;
+#  include "kernel/data_template.h"
+  int device_bvh, pad1;
+  int pad2, pad3;
+};
+static_assert(sizeof(KernelDataKC) == sizeof(KernelData), "KernelDataKC layout");
+static_assert(offsetof(KernelDataKC, background) == offsetof(KernelData, background), "KernelDataKC layout");
+static_assert(offsetof(KernelDataKC, integrator) == offsetof(KernelData, integrator), "KernelDataKC layout");
+static_assert(offsetof(KernelDataKC, svm_usage) == offsetof(KernelData, svm_usage), "KernelDataKC layout");
+static_assert(offsetof(KernelDataKC, device_bvh) == offsetof(KernelData, device_bvh), "KernelDataKC layout");
+#endif
+
 struct KernelParamsCUDA {
   /* Global scene data and textures */
+#ifdef CYCLES_KDATA_CONST
+  KernelDataKC data;
+#else
   KernelData data;
+#endif
 #define KERNEL_DATA_ARRAY(type, name) const type *name;
 #define KERNEL_DATA_ARRAY_WRITABLE(type, name) type *name;
 #include "kernel/data_arrays.h"
