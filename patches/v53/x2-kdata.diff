+#if defined(CYCLES_KDATA_DUMP) && defined(__KERNEL_CUDA__)
+/* Ours: print KernelData (field table once, then every distinct upload as raw words) from
+ * integrator_init_from_camera, for the per-scene constant folding of CYCLES_KDATA_CONST. */
+__device__ unsigned int kdc_dump_hash;
+__device__ int kdc_dump_count;
+ccl_device_noinline void kdata_dump()
+{
+  const unsigned int *w = (const unsigned int *)&kernel_params.data;
+  const int n = (int)(sizeof(KernelData) / 4);
+  unsigned int h = 2166136261u;
+  for (int i = 0; i < n; i++) {
+    h = (h ^ w[i]) * 16777619u;
+  }
+  if (kdc_dump_count && h == kdc_dump_hash) {
+    return;
+  }
+  kdc_dump_hash = h;
+  const int c = kdc_dump_count++;
+  printf("KDH %d %08x %d\n", c, h, n);
+  if (c == 0) {
+#  define KERNEL_STRUCT_MEMBER(parent, type, name) \
+    printf("KDF %s %s %s %d %d\n", #parent, #type, #name, (int)offsetof(KernelData, parent.name), (int)sizeof(type));
+#  include "kernel/data_template.h"
+  }
+  for (int i = 0; i < n; i += 4) {
+    printf("KDW %d %d %08x %08x %08x %08x\n", c, i, w[i], w[i + 1], w[i + 2], w[i + 3]);
+  }
+}
+#endif
 
